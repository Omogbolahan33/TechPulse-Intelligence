# =============================================================================
# TechPulse Intelligence — Environment Variables for Render Deployment
# =============================================================================
# Copy this file to .env for local development.
# On Render, set these in the Dashboard > Service > Environment tab.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# REQUIRED: Firebase Configuration
# -----------------------------------------------------------------------------
# Get these from: Firebase Console > Project Settings > General > Your apps
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firestore database ID (optional, defaults to "(default)")
FIRESTORE_DATABASE_ID=your-firestore-database-id

# -----------------------------------------------------------------------------
# AI Provider API Keys (at least one required for AI features)
# -----------------------------------------------------------------------------
# Gemini AI (Primary - has free tier)
# Get key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Groq (Fast inference, free tier available)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (GPT-4o)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter (Universal aggregator, includes Perplexity Sonar for search)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL: Application URL
# -----------------------------------------------------------------------------
# Your Render app URL (used for metadata, OAuth callbacks)
# APP_URL=https://your-app.onrender.com
