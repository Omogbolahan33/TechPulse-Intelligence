// ===============================================================
// Firestore Security Rules — TechPulse Intelligence
// ===============================================================
//
// Data Model:
//
// Collection: /news/{articleId}
//   - Public read, authenticated write (server prefetch via service account)
//
// Collection: /synthesis/{articleId}
//   - Public read, authenticated write (server prefetch via service account)
//
// Collection: /articles/{articleId}/comments/{commentId}
//   - Public read, authenticated create, owner delete
//
// Collection: /likes/{likeId}
//   - Public read, authenticated create/delete own
//
// Collection: /bookmarks/{bookmarkId}
//   - Owner read/write only
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has admin role (stored in custom claims or admin collection)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidComment(data) {
      return data.keys().hasAll(['articleId', 'userId', 'userName', 'text', 'createdAt']) &&
             data.articleId is string &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() < 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
             data.createdAt is timestamp;
    }

    function isValidNewsArticle(data) {
      return data.keys().hasAll(['id', 'title', 'summary', 'category', 'timestamp', 'source', 'imageUrl', 'url']) &&
             data.id is string &&
             data.title is string && data.title.size() > 0 &&
             data.summary is string && data.summary.size() > 0 &&
             data.category is string &&
             data.source is string &&
             data.url is string &&
             data.imageUrl is string;
    }

    function isValidSynthesis(data) {
      return data.keys().hasAll(['articleId', 'fullContent', 'keyTakeaways']) &&
             data.articleId is string &&
             data.fullContent is string;
    }

    // News collection
    // Public read for all users
    // Write restricted to authenticated admin users or service accounts
    match /news/{articleId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNewsArticle(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Synthesis collection
    // Public read for all users
    // Write restricted to authenticated admin users or service accounts
    match /synthesis/{articleId} {
      allow read: if true;
      allow create: if isAdmin() && isValidSynthesis(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Articles collection (for comments)
    match /articles/{articleId} {
      allow read: if true;

      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        
        // Only authenticated users can create comments for themselves
        allow create: if isAuthenticated() && isValidComment(request.resource.data);
        
        // Only the owner can delete their comment
        allow delete: if isAuthenticated() && isOwner(resource.data.userId);

        // Comments are immutable (no updates)
        allow update: if false;
      }
    }

    // Likes collection
    match /likes/{likeId} {
      // Anyone can see like counts
      allow read: if true;
      
      // Only authenticated users can like/unlike
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      likeId == request.auth.uid + "_" + request.resource.data.targetId;
      
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      // Only the owner can read their bookmarks
      allow read: if isAuthenticated() && (resource == null || isOwner(resource.data.userId));
      
      // Only authenticated users can bookmark for themselves
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      bookmarkId == request.auth.uid + "_" + request.resource.data.articleId;
      
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Admins collection (for admin role verification)
    match /admins/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Only writable via Admin SDK
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
